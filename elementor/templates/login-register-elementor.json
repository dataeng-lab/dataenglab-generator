              "id": "f4ec8ac",
              "elType": "widget",
              "settings": {
                "html": "<style>\n.nextend-social-login{ width: 100%; }\n.auth{\n  --auth-indigo: var(--indigo, #5A4FE5);\n  --auth-indigo-dark: var(--indigo-dark, #372DBF);\n  --auth-indigo-bg: var(--indigo-bg, #ECEAFB);\n  --auth-indigo-ink: var(--indigo-ink, #2E2599);\n  --auth-teal: var(--teal, #0E9C8B);\n  --auth-teal-bg: var(--teal-bg, #E0F4F1);\n  --auth-teal-ink: var(--teal-ink, #0B5A50);\n  --auth-coral: var(--coral, #FF5A36);\n  --auth-ink: var(--ink, #14151A);\n  --auth-ink-soft: var(--ink-soft, #54575F);\n  --auth-ink-faint: var(--ink-faint, #92959E);\n  --auth-bg: var(--bg, #FBFBF8);\n  --auth-surface: var(--surface, #FFFFFF);\n  --auth-border: var(--border, #E7E3D9);\n  --auth-panel: var(--panel-dark, #1B1940);\n  --auth-panel-tint: var(--panel-dark-tint, #2A2760);\n  --auth-panel-ink: var(--panel-dark-ink, #E4E2F5);\n  --auth-radius-sm: var(--radius-sm, 10px);\n  --auth-radius-md: var(--radius-md, 16px);\n  --auth-radius-lg: var(--radius-lg, 26px);\n  --auth-radius-full: var(--radius-full, 999px);\n  --auth-font-display: var(--font-display, 'Instrument Sans', system-ui, sans-serif);\n  --auth-font-body: var(--font-body, 'Inter', system-ui, sans-serif);\n  --auth-font-mono: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);\n  --auth-container: var(--container, 1200px);\n\n  background: var(--auth-bg);\n  padding: 96px 24px;\n  font-family: var(--auth-font-body);\n  color: var(--auth-ink);\n}\n.auth .wrap{ max-width: 560px; margin: 0 auto; }\n.auth .auth-inner{ text-align: center; }\n.auth .auth-copy{ text-align: center; }\n.auth .lede{ margin-left: auto; margin-right: auto; }\n.auth .form-card{ text-align: left; }\n\n/* --- Form card --------------------------------------------------------- */\n.auth .type-tag{\n  display: inline-flex;\n  align-items: center;\n  font-family: var(--auth-font-mono);\n  font-size: 12px;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n  font-weight: 600;\n  padding: 6px 12px;\n  border-radius: var(--auth-radius-full);\n  background: var(--auth-indigo-bg);\n  color: var(--auth-indigo-ink);\n  margin-bottom: 18px;\n}\n.auth h1{\n  font-family: var(--auth-font-display);\n  font-size: clamp(2rem, 3.2vw, 2.75rem);\n  line-height: 1.12;\n  font-weight: 600;\n  margin: 0 0 10px;\n}\n.auth h1 .accent{ color: var(--auth-indigo); }\n.auth .lede{\n  font-size: 1.05rem;\n  line-height: 1.55;\n  color: var(--auth-ink-soft);\n  max-width: 42ch;\n  margin: 0 0 32px;\n}\n\n.auth .form-card{\n  background: var(--auth-surface);\n  border: 1px solid var(--auth-border);\n  border-radius: var(--auth-radius-lg);\n  padding: 32px;\n  box-shadow: 0 20px 48px rgba(20,21,26,.06);\n}\n.auth .field{ margin-bottom: 18px; }\n.auth .field label{\n  display: block;\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--auth-ink);\n  margin-bottom: 6px;\n}\n.auth .field input[type=\"text\"],\n.auth .field input[type=\"email\"],\n.auth .field input[type=\"password\"]{\n  width: 100%;\n  box-sizing: border-box;\n  font-family: var(--auth-font-body);\n  font-size: 15px;\n  padding: 13px 14px;\n  border: 1px solid var(--auth-border);\n  border-radius: var(--auth-radius-sm);\n  background: var(--auth-bg);\n  color: var(--auth-ink);\n  transition: border-color .15s ease, box-shadow .15s ease;\n}\n.auth .field input:focus{\n  outline: none;\n  border-color: var(--auth-indigo);\n  box-shadow: 0 0 0 3px var(--auth-indigo-bg);\n}\n.auth .field-row{\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 22px;\n  font-size: 13.5px;\n}\n.auth .checkbox-row{\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  font-size: 13.5px;\n  color: var(--auth-ink-soft);\n  margin-bottom: 22px;\n}\n.auth .checkbox-row input{ margin-top: 3px; accent-color: var(--auth-indigo); }\n.auth .checkbox-row a{ color: var(--auth-indigo); text-decoration: none; font-weight: 600; }\n.auth .remember{\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--auth-ink-soft);\n}\n.auth .remember input{ accent-color: var(--auth-indigo); }\n.auth .link-muted{ color: var(--auth-ink-faint); text-decoration: none; }\n.auth .link-muted:hover{ color: var(--auth-indigo); }\n\n.auth .btn{\n  display: inline-flex;\n  width: 100%;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--auth-font-body);\n  font-weight: 600;\n  font-size: 1rem;\n  padding: 14px 26px;\n  border-radius: var(--auth-radius-sm);\n  text-decoration: none;\n  border: none;\n  cursor: pointer;\n  transition: transform .15s ease, box-shadow .15s ease, background .15s ease;\n}\n.auth .btn-primary{\n  background: var(--auth-indigo);\n  color: #fff;\n  box-shadow: 0 8px 20px rgba(90,79,229,.28);\n}\n.auth .btn-primary:hover{ background: var(--auth-indigo-dark); transform: translateY(-1px); }\n.auth .btn-social{\n  background: var(--auth-surface);\n  color: var(--auth-ink);\n  border: 1px solid var(--auth-border);\n  gap: 10px;\n}\n.auth .btn-social:hover{ border-color: var(--auth-indigo); color: var(--auth-indigo); }\n\n.auth .divider{\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin: 22px 0;\n  font-size: 12px;\n  letter-spacing: .04em;\n  text-transform: uppercase;\n  color: var(--auth-ink-faint);\n}\n.auth .divider::before,\n.auth .divider::after{\n  content: \"\";\n  flex: 1;\n  height: 1px;\n  background: var(--auth-border);\n}\n\n.auth .switch-note{\n  text-align: center;\n  font-size: 13.5px;\n  color: var(--auth-ink-soft);\n  margin-top: 24px;\n}\n.auth .switch-note a{ color: var(--auth-indigo); font-weight: 600; text-decoration: none; }\n\n@media (max-width: 600px){\n  .auth{ padding: 56px 20px; }\n  .auth .form-card{ padding: 24px; }\n}\n</style>\n\n<!--\n  VISUAL MOCKUP ONLY — form fields below use generic name/id attributes.\n  A dev needs to swap the <form> body for the real Tutor LMS registration\n  shortcode/widget markup so submit, AJAX email-verification, \"Remember Me\",\n  and the Terms modal keep working. Structure and copy are kept close to\n  the live page so the swap is easy to map field-by-field.\n\n  GOOGLE LOGIN: use the Nextend Social Login plugin, not custom OAuth code.\n  The .nextend-social-login placeholder below must be replaced with the\n  plugin's actual output — do NOT leave it as literal shortcode text,\n  because Elementor's raw HTML widget does not run do_shortcode(). Either:\n    a) delete the placeholder and drop an Elementor \"Shortcode\" widget\n       next to this HTML widget containing:\n       [nextend_social_login provider=\"google\" style=\"icon\"]\n    b) or call nextend_social_login('google', 'icon') from a PHP snippet\n       (e.g. via Code Snippets / a shortcode you register) and reference\n       that shortcode here instead.\n  Style target to match: .btn.btn-social (full-width pill, 1px border,\n  var(--auth-border), 14px vertical padding) — Nextend's \"icon\" style is\n  closest; override its CSS to inherit .btn-social sizing.\n-->\n<section class=\"auth\">\n  <div class=\"wrap auth-inner\">\n    <div class=\"auth-copy\" style=\"max-width: 480px; margin: 0 auto;\">\n      <span class=\"type-tag\">Register</span>\n      <h1>Sign up and start your <span class=\"accent\">Data Engineering</span> journey.</h1>\n      <p class=\"lede\">Create your free account to unlock guided labs, graded exercises, and a portfolio you can show employers.</p>\n\n      <div class=\"form-card\">\n        <form>\n          <div class=\"field\">\n            <label for=\"reg-username\">Username or Email Address</label>\n            <input type=\"text\" id=\"reg-username\" name=\"username\" placeholder=\"you@example.com\">\n          </div>\n          <div class=\"field\">\n            <label for=\"reg-password\">Password</label>\n            <input type=\"password\" id=\"reg-password\" name=\"password\" placeholder=\"••••••••\">\n          </div>\n\n          <div class=\"checkbox-row\">\n            <input type=\"checkbox\" id=\"reg-terms\" name=\"terms\">\n            <label for=\"reg-terms\">I accept <a href=\"#\">the Terms and Conditions.</a></label>\n          </div>\n\n          <button type=\"submit\" class=\"btn btn-primary\">Register</button>\n\n          <div class=\"divider\">Other sign up option</div>\n\n          <div class=\"nextend-social-login\">\n            <!-- DEV: replace with real Nextend Social Login output — see comment above. Visual placeholder only. -->\n            <button type=\"button\" class=\"btn btn-social\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 48 48\"><path fill=\"#FFC107\" d=\"M43.6 20.5H42V20H24v8h11.3C33.9 32.6 29.4 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.1 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z\"/><path fill=\"#FF3D00\" d=\"M6.3 14.7l6.6 4.8C14.5 16 18.9 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.1 29.5 4 24 4 16.3 4 9.7 8.3 6.3 14.7z\"/><path fill=\"#4CAF50\" d=\"M24 44c5.3 0 10.2-2 13.9-5.4l-6.4-5.4C29.4 34.9 26.8 36 24 36c-5.3 0-9.8-3.4-11.3-8.1l-6.5 5C9.6 39.6 16.3 44 24 44z\"/><path fill=\"#1976D2\" d=\"M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.4 5.4C41.4 36 44 30.5 44 24c0-1.3-.1-2.7-.4-3.5z\"/></svg>\n              Continue with Google\n            </button>\n          </div>\n        </form>\n\n        <p class=\"switch-note\">Already have an account? <a href=\"#\">Sign In</a></p>\n      </div>\n    </div>\n  </div>\n</section>\n"
              },
              "widgetType": "html",
              "elements": []
            }
          ]
        }
      ]
    }
  ],
