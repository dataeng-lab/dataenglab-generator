        {
          "id": "aa29413",
          "elType": "widget",
          "widgetType": "icon-list",
          "settings": {
            "icon_list": [
              {
                "text": "Determine a table's actual grain from its data, not from its name",
                "selected_icon": {
                  "value": "fas fa-check",
                  "library": "fa-solid"
                },
                "_id": "d49b287"
              },
              {
                "text": "Explain how joining tables at mismatched grains fans out rows and inflates totals",
                "selected_icon": {
                  "value": "fas fa-check",
                  "library": "fa-solid"
                },
                "_id": "80a06d6"
              },
              {
                "text": "Deduplicate late-arriving records deterministically with ROW_NUMBER(), including NULLs and exact ties",
                "selected_icon": {
                  "value": "fas fa-check",
                  "library": "fa-solid"
                },
                "_id": "8cc2a15"
              },
              {
                "text": "Aggregate to the correct grain before joining instead of joining raw and hoping GROUP BY fixes it",
                "selected_icon": {
                  "value": "fas fa-check",
                  "library": "fa-solid"
                },
                "_id": "82193b5"
              },
              {
                "text": "Surface a data-quality flag instead of letting SUM() silently drop a NULL value",
