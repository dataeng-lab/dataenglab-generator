                  "bottom": "16",
                  "left": "16",
                  "isLinked": true
                },
                "padding": {
                  "unit": "px",
                  "top": "24",
                  "right": "24",
                  "bottom": "24",
                  "left": "24",
                  "isLinked": true
                }
              },
              "elements": [
                {
                  "id": "f44e366",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "order_items — grain: 1 row per line item",
                    "header_size": "h3",
                    "title_color": "#14151A"
                  },
                  "elements": []
                },
                {
                  "id": "c9d6374",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>A line-item-grain fact table — the correct child grain for joining to an order-grain parent. One row per line item per order is expected and correct; several rows per order_id here are not a bug.</p>",
                    "text_color": "#54575F"
                  },
                  "elements": []
                },
                {
                  "id": "ee53473",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<table style=\"width:100%;table-layout:fixed;border-collapse:collapse;font-size:14px;\"><colgroup><col style=\"width:26%;\"><col style=\"width:18%;\"><col style=\"width:56%;\"></colgroup><tr style=\"border-bottom:1px solid #E7E3D9;\"><th style=\"text-align:left;padding:8px;color:#54575F;\">Field</th><th style=\"text-align:left;padding:8px;color:#54575F;\">Type</th><th style=\"text-align:left;padding:8px;color:#54575F;\">Description</th></tr><tr style=\"border-bottom:1px solid #E7E3D9;background:#FBFBF8;\"><td style=\"padding:8px;word-wrap:break-word;\">order_item_id</td><td style=\"padding:8px;word-wrap:break-word;\">text</td><td style=\"padding:8px;word-wrap:break-word;\">Primary key</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;word-wrap:break-word;\">order_id</td><td style=\"padding:8px;word-wrap:break-word;\">text</td><td style=\"padding:8px;word-wrap:break-word;\">Foreign key → orders.order_id</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;background:#FBFBF8;\"><td style=\"padding:8px;word-wrap:break-word;\">sku</td><td style=\"padding:8px;word-wrap:break-word;\">text</td><td style=\"padding:8px;word-wrap:break-word;\">Product SKU</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;word-wrap:break-word;\">quantity</td><td style=\"padding:8px;word-wrap:break-word;\">integer</td><td style=\"padding:8px;word-wrap:break-word;\">Units ordered</td></tr><tr style=\"background:#FBFBF8;\"><td style=\"padding:8px;word-wrap:break-word;\">unit_price</td><td style=\"padding:8px;word-wrap:break-word;\">numeric</td><td style=\"padding:8px;word-wrap:break-word;\">NULL on a few rows — a known upstream data gap</td></tr></table>"
                  },
                  "elements": []
                }
              ]
            }
          ]
        }
      ]
    },
