        {
          "id": "0001002",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Investigate Duplicate Orders",
            "header_size": "h1",
            "title_color": "#14151A"
          },
          "elements": []
        },
        {
          "id": "0001003",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>A revenue dashboard is double-counting sales. Finance noticed the dashboard's total doesn't match the payment processor, and a few order IDs show up more than once in exports. You've been asked to trace the issue and hand back a query the dashboard team can trust.</p>",
            "text_color": "#54575F"
          },
          "elements": []
        }
      ]
    },
