                {
                  "id": "000100e",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>An append-only, event-sourced fact table: a new row is written every time an order's status changes, so the table holds one row per status update, not one row per order.</p>",
                    "text_color": "#54575F"
                  },
                  "elements": []
                },
                {
                  "id": "000100f",
                  "elType": "widget",
                  "widgetType": "icon-list",
                  "settings": {
                    "icon_list": [
                      {
                        "text": "event_id (PK, integer) \u2014 Surrogate primary key for this version row",
                        "selected_icon": {
                          "value": "fas fa-circle",
                          "library": "fa-solid"
                        },
                        "_id": "0001010"
                      },
                      {
                        "text": "order_id (KEY, text) \u2014 The order's business/natural key \u2014 repeats across versions",
                        "selected_icon": {
                          "value": "fas fa-circle",
                          "library": "fa-solid"
                        },
                        "_id": "0001011"
                      },
                      {
                        "text": "customer_id (text) \u2014 NULL for guest checkouts",
                        "selected_icon": {
