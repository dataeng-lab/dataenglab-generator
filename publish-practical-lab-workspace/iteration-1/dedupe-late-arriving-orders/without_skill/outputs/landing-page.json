        {
          "id": "114",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p><strong>order_events</strong> &mdash; grain: 1 row per status-update delivery. One row is written every time an order's status changes, plus the occasional exact-duplicate redelivery.</p>",
            "text_color": "#54575F"
          },
          "elements": []
        },
        {
          "id": "115",
          "elType": "widget",
          "widgetType": "icon-list",
          "settings": {
            "icon_list": [
              {
                "text": "event_id (KEY) &mdash; delivery ID, repeats on an exact-duplicate redelivery",
                "selected_icon": {
                  "value": "fas fa-database",
                  "library": "fa-solid"
                },
                "_id": "116"
              },
              {
                "text": "order_id (KEY) &mdash; the order's business ID, repeats across status updates",
                "selected_icon": {
                  "value": "fas fa-database",
                  "library": "fa-solid"
                },
                "_id": "117"
              },
              {
                "text": "status &mdash; created / paid / refunded / cancelled",
                "selected_icon": {
                  "value": "fas fa-database",
                  "library": "fa-solid"
                },
                "_id": "118"
              },
              {
                "text": "event_ts &mdash; when the event happened; missing on a few rows",
                "selected_icon": {
                  "value": "fas fa-database",
                  "library": "fa-solid"
                },
                "_id": "119"
              },
              {
                "text": "sequence_no &mdash; monotonic per-order delivery counter; always present",
                "selected_icon": {
                  "value": "fas fa-database",
                  "library": "fa-solid"
                },
                "_id": "11a"
              }
            ],
            "icon_color": "#5A4FE5",
            "text_color": "#14151A"
          },
          "elements": []
        },
