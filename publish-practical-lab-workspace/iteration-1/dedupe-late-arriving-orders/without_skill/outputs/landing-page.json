        {
          "id": "107",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>Support escalated that a customer's order tracker shows an order as <strong>paid</strong> when it was actually <strong>refunded</strong> three days ago. The event delivery is at-least-once and can arrive out of order &mdash; you've been asked to trace the issue and hand back a script that produces the trusted, current status for every order.</p>",
            "text_color": "#54575F"
          },
          "elements": []
        },
