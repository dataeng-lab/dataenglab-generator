                {
                  "id": "fce8dc4",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<table style=\"width:100%;border-collapse:collapse;font-size:14px;\"><tr style=\"border-bottom:1px solid #E7E3D9;\"><th style=\"text-align:left;padding:8px;color:#54575F;\">Field</th><th style=\"text-align:left;padding:8px;color:#54575F;\">Type</th><th style=\"text-align:left;padding:8px;color:#54575F;\">Description</th></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;\">event_id</td><td style=\"padding:8px;\">integer</td><td style=\"padding:8px;\">Primary key for this version row</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;\">order_id</td><td style=\"padding:8px;\">text</td><td style=\"padding:8px;\">The order's business ID — repeats across versions</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;\">customer_id</td><td style=\"padding:8px;\">text</td><td style=\"padding:8px;\">NULL for guest checkouts</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;\">status</td><td style=\"padding:8px;\">text</td><td style=\"padding:8px;\">created / paid / refunded / cancelled</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;\">order_ts</td><td style=\"padding:8px;\">timestamp</td><td style=\"padding:8px;\">When the order was first created</td></tr><tr style=\"border-bottom:1px solid #E7E3D9;\"><td style=\"padding:8px;\">updated_at</td><td style=\"padding:8px;\">timestamp</td><td style=\"padding:8px;\">When this row was written; NULL on the very first event</td></tr><tr><td style=\"padding:8px;\">order_version</td><td style=\"padding:8px;\">integer</td><td style=\"padding:8px;\">Increases every time a new row is appended for this order</td></tr></table>"
