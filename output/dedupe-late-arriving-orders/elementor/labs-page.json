          "settings": {
            "tabs": [
              {
                "tab_title": "output/orders_deduped.csv not found when running the test",
                "tab_content": "Run python starter/dedupe.py yourself first; the starter ships with dedupe() raising NotImplementedError until you implement it.",
                "_id": "dla0052a"
              },
              {
                "tab_title": "Still shows O-2008 as paid, not refunded",
                "tab_content": "You're likely still picking \"the last row for this order_id in the file\" instead of sorting by event_ts/sequence_no; O-2008's events arrive in the file out of chronological order.",
                "_id": "dla0052b"
              },
              {
                "tab_title": "O-2004 comes back paid instead of cancelled",
                "tab_content": "Its two events share the exact same event_ts; you need sequence_no as the tie-break, not just event_ts alone.",
                "_id": "dla0052c"
              }
            ],
