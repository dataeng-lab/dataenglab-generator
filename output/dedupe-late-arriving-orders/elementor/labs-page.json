          "settings": {
            "icon_list": [
              { "text": "Recognize that a raw event log isn't the same as \"current state,\" and that file row order isn't a reliable proxy for event chronology", "selected_icon": { "value": "fas fa-check", "library": "fa-solid" }, "_id": "dla0012a" },
              { "text": "Deduplicate exact-duplicate deliveries before doing any further processing", "selected_icon": { "value": "fas fa-check", "library": "fa-solid" }, "_id": "dla0012b" },
              { "text": "Deterministically pick the true latest record per key when the ordering column can be missing or tied", "selected_icon": { "value": "fas fa-check", "library": "fa-solid" }, "_id": "dla0012c" },
              { "text": "Surface a dropped-duplicate signal instead of silently discarding the fact that a redelivery happened", "selected_icon": { "value": "fas fa-check", "library": "fa-solid" }, "_id": "dla0012d" }
